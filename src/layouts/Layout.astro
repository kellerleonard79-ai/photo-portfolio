---
// Self-hosted at build time via Fontsource — no external font requests, no
// layout shift (§6). Fraunces is variable (optical-size + weight axes); Inter
// is variable (weight axis).
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';

interface Props {
  title: string;
  description?: string;
  /** Absolute-or-hashed image src for the Open Graph card (§5). */
  ogImage?: string;
  /** Page type for OG. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Photographs by Keller Leonard.',
  ogImage,
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The link is pasted into chat apps — the preview card is the first impression
// as often as the site is (§5). OG image must be absolute.
const ogImageAbs = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Keller Leonard" />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}

    <meta name="twitter:card" content={ogImageAbs ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Cool near-black ground with a single restrained steel-blue accent (§6). */
    --bg: #0f1114;
    --surface: #16191d;
    --text: #eceef1;
    --text-muted: #9aa0a8;
    --text-faint: #666c74;
    --accent: #6ea3cf;
    --accent-bright: #8fbce0;

    /* Type: Fraunces (display) + Inter (UI/body). */
    --font-display: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
    --font-ui: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;

    /* Type scale, 1.25 ratio off a 1rem base (§6). */
    --step--1: 0.8rem;
    --step-0: 1rem;
    --step-1: 1.25rem;
    --step-2: 1.5625rem;
    --step-3: 1.953rem;
    --step-4: 2.441rem;
    --step-5: 3.052rem;
    --step-6: 3.815rem;

    --max: 1180px;
    --gap: 8px;
  }

  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  html,
  body {
    margin: 0;
    padding: 0;
  }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    font-weight: 400;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
    /* Use the optical-size axis at large sizes (§6). */
    font-variation-settings: 'opsz' 144;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  a:hover {
    color: var(--accent);
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Visible focus indicator (§7). */
  :focus-visible {
    outline: 2px solid var(--accent-bright);
    outline-offset: 3px;
    border-radius: 2px;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
