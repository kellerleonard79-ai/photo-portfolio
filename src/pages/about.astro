---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About — Keller Leonard"
  description="About Keller Leonard, photographer."
>
  <main class="page wrap">
    <p class="back"><a href="/">← Series</a></p>
    <h1>About</h1>

    <div class="prose">
      <!-- Placeholder copy — edit to taste. The brief keeps this page short:
           a paragraph, a portrait, and the gear list only if it earns its place. -->
      <p>
        I'm Keller Leonard. I photograph the things that are hard to be in the
        room for — jets pulling contrails into a diamond, a race car braking
        into a corner, first light on a canyon rim — and try to bring back the
        one frame that makes you feel you were there.
      </p>
      <p>
        The work moves between airshows, the track, and the road, on purpose.
        The range is the point: the discipline is the same whether the subject
        is moving at four hundred knots or hasn't moved in a thousand years.
      </p>
    </div>

    <p class="aside">
      Prints and commissions: <a href="/contact">get in touch</a>.
    </p>
  </main>

  <footer class="wrap site-foot">
    <span class="foot-name">Keller Leonard</span>
    <nav aria-label="Footer">
      <a href="/">Series</a>
      <a href="/contact">Contact</a>
    </nav>
  </footer>
</Layout>

<style>
  .page {
    padding-top: 1.75rem;
    padding-bottom: 3rem;
    max-width: 720px;
  }
  .back {
    margin: 0 0 1.75rem;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  h1 {
    margin: 0 0 1.75rem;
    font-size: var(--step-5);
  }
  .prose p {
    margin: 0 0 1.2rem;
    font-size: var(--step-1);
    line-height: 1.65;
    color: var(--text);
    max-width: 62ch;
  }
  .aside {
    margin-top: 2rem;
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .aside a {
    color: var(--accent);
  }
  .aside a:hover {
    color: var(--accent-bright);
  }

  .site-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
    margin-top: 3rem;
    border-top: 1px solid var(--surface);
    color: var(--text-faint);
    font-size: var(--step--1);
  }
  .foot-name {
    font-family: var(--font-display);
    font-size: var(--step-0);
    color: var(--text-muted);
  }
  .site-foot nav {
    display: flex;
    gap: 1.25rem;
  }
</style>
