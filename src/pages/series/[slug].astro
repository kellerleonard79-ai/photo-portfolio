---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import { seriesPhotos, coverPhoto, type Photo as PhotoT } from '../../lib/series';

export async function getStaticPaths() {
  const series = await getCollection('series');
  return series.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const photos = await seriesPhotos(entry.id, entry.data.images);
const cover = await coverPhoto(entry.id, entry.data.cover, entry.data.images);

// Build-time justified rows (§6). Images scale to a shared per-row height and
// pack edge-to-edge; aspect ratios are preserved exactly (never cropped) and
// sequence order is kept. Widths are percentages of the container so the layout
// stays responsive with no client JS. A `full` image breaks the rhythm as its
// own full-bleed row.
const GAP = 8;
const TARGET = 380;
const CONTAINER = 1180;

type Cell = PhotoT & { widthPct: number };
type Row = { full: boolean; items: Cell[] };

function justify(items: PhotoT[]): Row[] {
  const rows: Row[] = [];
  let cur: PhotoT[] = [];
  let arSum = 0;

  const flush = (justified: boolean) => {
    if (!cur.length) return;
    const totalGap = GAP * (cur.length - 1);
    const h = justified ? (CONTAINER - totalGap) / arSum : TARGET;
    rows.push({
      full: false,
      items: cur.map((p) => ({ ...p, widthPct: ((p.ar * h) / CONTAINER) * 100 })),
    });
    cur = [];
    arSum = 0;
  };

  for (const p of items) {
    if (p.full) {
      flush(false);
      rows.push({ full: true, items: [{ ...p, widthPct: 100 }] });
      continue;
    }
    cur.push(p);
    arSum += p.ar;
    // Row is full once its natural width reaches the container.
    if (arSum * TARGET + GAP * (cur.length - 1) >= CONTAINER) flush(true);
  }
  flush(false); // final partial row: natural height, left-aligned (§6).
  return rows;
}

const rows = justify(photos);
---

<Layout
  title={`${entry.data.title} — Keller Leonard`}
  description={entry.data.blurb ?? `${entry.data.title}, photographed by Keller Leonard.`}
  ogImage={cover?.data.src}
  ogType="article"
>
  <main class="series wrap">
    <p class="back"><a href="/">← Series</a></p>
    <header class="series-head">
      <h1>{entry.data.title}</h1>
      {entry.data.blurb && <p class="blurb">{entry.data.blurb}</p>}
    </header>

    <div class="gallery">
      {rows.map((row, ri) => (
        <div class:list={['jrow', { full: row.full }]}>
          {row.items.map((cell) =>
            row.full ? (
              <figure class="jfig">
                <Photo
                  photo={cell}
                  sizes="(max-width: 1180px) 100vw, 1180px"
                  eager={ri === 0}
                  class="jframe"
                  style={`width:100%; aspect-ratio:${cell.ar};`}
                />
                {cell.caption && <figcaption>{cell.caption}</figcaption>}
              </figure>
            ) : (
              <Photo
                photo={cell}
                sizes="(max-width: 600px) 100vw, (max-width: 1180px) 50vw, 590px"
                eager={ri === 0}
                class="jframe"
                style={`width:${cell.widthPct}%; aspect-ratio:${cell.ar};`}
              />
            ),
          )}
        </div>
      ))}
    </div>
  </main>

  <footer class="wrap site-foot">
    <span class="foot-name">Keller Leonard</span>
    <nav aria-label="Footer">
      <a href="/">Series</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
  </footer>
</Layout>

<style>
  .series {
    padding-top: 1.75rem;
    padding-bottom: 3rem;
  }
  .back {
    margin: 0 0 1.75rem;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .series-head {
    margin-bottom: 2.5rem;
    max-width: 60ch;
  }
  .series-head h1 {
    margin: 0;
    font-size: var(--step-5);
  }
  .blurb {
    margin: 0.9rem 0 0;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  .jrow {
    display: flex;
    gap: var(--gap);
    align-items: flex-start;
  }
  .jrow :global(.jframe) {
    border-radius: 2px;
  }
  .jfig {
    margin: 0;
    width: 100%;
  }
  .jfig figcaption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  /* Below ~600px, one big immersive frame at a time (§6). */
  @media (max-width: 600px) {
    .jrow {
      flex-direction: column;
      gap: var(--gap);
    }
    .jrow :global(.jframe) {
      width: 100% !important;
    }
  }

  .site-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
    margin-top: 3rem;
    border-top: 1px solid var(--surface);
    color: var(--text-faint);
    font-size: var(--step--1);
  }
  .foot-name {
    font-family: var(--font-display);
    font-size: var(--step-0);
    color: var(--text-muted);
  }
  .site-foot nav {
    display: flex;
    gap: 1.25rem;
  }
</style>
