{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-16",
	"name": "photo-portfolio",
	// Static-assets-only Worker: no server entry (`main`). Astro's static build
	// output in ./dist is served directly from Cloudflare's edge.
	"assets": {
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	}
}
